<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Summer.Views.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Summer.Controls" xmlns:helpers="clr-namespace:Summer.Helpers" Background="#00FFFFFF" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushTextPrimary}" xmlns:views="clr-namespace:Summer.Views;assembly=Summer" Loaded="OnLoaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DownloadActionControlStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Background" Value="#25252D" />
        <Setter Property="BorderBrush" Value="#3B3B46" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Surface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="3">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Surface" Property="Border.Background" Value="#383842" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Surface" Property="Border.Background" Value="#1A1A20" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Surface" Property="Border.BorderBrush" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ServerCardItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Foreground" Value="#CFCFCF" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Card" Background="#0F0F0F" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Grid helpers:WindowChrome.RoundedClip="9">
                  <Image Name="Cover" Stretch="UniformToFill" Opacity="0.8" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CoverImage}">
                    <UIElement.Effect>
                      <BlurEffect Radius="7" KernelType="Gaussian" />
                    </UIElement.Effect>
                  </Image>
                  <Border>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#990B0B0B" />
                        <GradientStop Offset="0.45" Color="#B30B0B0B" />
                        <GradientStop Offset="1" Color="#E60B0B0B" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Border Name="Hover" Background="#12FFFFFF" Opacity="0" />
                  <Border Name="Tint" Opacity="0">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#8C220F12" />
                        <GradientStop Offset="0.55" Color="#2E1A0B0D" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                  <Border Name="Accent" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="0,2,2,0" Opacity="0" Background="{StaticResource BrushAccent}" />
                  <ContentPresenter Margin="22,19,22,17" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Card" Property="Border.BorderBrush" Value="#323232" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetName="Cover" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="0" Duration="0:0:0.22" />
                        <DoubleAnimation Storyboard.TargetName="Cover" Storyboard.TargetProperty="Opacity" To="0.95" Duration="0:0:0.22" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                        <DoubleAnimation Storyboard.TargetName="Cover" Storyboard.TargetProperty="(UIElement.Effect).(BlurEffect.Radius)" To="7" Duration="0:0:0.28" />
                        <DoubleAnimation Storyboard.TargetName="Cover" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.28" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.ExitActions>
                </Trigger>
                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                  <Setter TargetName="Card" Property="Border.BorderBrush" Value="#5A2A2F" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                  <TriggerBase.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                        <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.EnterActions>
                  <TriggerBase.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                        <DoubleAnimation Storyboard.TargetName="Accent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                      </Storyboard>
                    </BeginStoryboard>
                  </TriggerBase.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <EventSetter Event="MouseLeftButtonUp" Handler="ServerCard_OnMouseLeftButtonUp" />
        <EventSetter Event="PreviewKeyDown" Handler="ServerCard_OnPreviewKeyDown" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="18" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="212" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Name="HeroCard" Grid.Row="0" Background="#101010" BorderBrush="#242424" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
      <UIElement.RenderTransform>
        <TranslateTransform Y="10" />
      </UIElement.RenderTransform>
      <Grid helpers:WindowChrome.RoundedClip="9">
        <Grid Margin="32,28,30,30">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Name="HeroCoverLayer" RowSpan="2" Margin="-32,-28,-30,-30" ClipToBounds="True" IsHitTestVisible="False">
            <Image Name="HeroCoverA" Stretch="UniformToFill" Opacity="0.78" RenderOptions.BitmapScalingMode="HighQuality">
              <UIElement.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" />
              </UIElement.Effect>
            </Image>
            <Image Name="HeroCoverB" Stretch="UniformToFill" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality">
              <UIElement.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" />
              </UIElement.Effect>
            </Image>
          </Grid>
          <Border Grid.RowSpan="2" Margin="-32,-28,-30,-30">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#EE101010" />
                <GradientStop Offset="0.3" Color="#D9101010" />
                <GradientStop Offset="0.55" Color="#80101010" />
                <GradientStop Offset="0.8" Color="#40101010" />
                <GradientStop Offset="1" Color="#59101010" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Grid.RowSpan="2" Margin="-32,-28,-30,-30">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#26101010" />
                <GradientStop Offset="0.45" Color="#14101010" />
                <GradientStop Offset="0.72" Color="#8C101010" />
                <GradientStop Offset="1" Color="#F2101010" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Grid Row="0">
            <StackPanel Name="ServerInfoPanel" Grid.Column="0" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Center">
              <UIElement.RenderTransform>
                <TranslateTransform X="0" />
              </UIElement.RenderTransform>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="26" Height="2" Margin="0,0,10,0" VerticalAlignment="Center" Background="{StaticResource BrushAccent}" />
                <TextBlock Text="SUMMER NETWORK / RUST" FontFamily="{StaticResource FontBody}" FontSize="10.5" FontWeight="SemiBold" Foreground="#AAAAAA" VerticalAlignment="Center" />
                <Border Margin="14,0,0,0" Padding="8,3" Background="#2B1013" BorderBrush="#661C22" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center" Visibility="{Binding IsInstallNeeded, Converter={StaticResource BoolToVisibility}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsInstallNeeded}">
                          <TriggerBase.EnterActions>
                            <BeginStoryboard>
                              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.9" />
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.EnterActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#FF3B47" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" FontWeight="Bold" Foreground="#FF4A55" VerticalAlignment="Center" Text="{helpers:Loc Status_InstallNeeded}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Margin="0,16,0,0" FontFamily="{StaticResource FontDisplay}" FontSize="84" FontWeight="SemiBold" LineHeight="88" LineStackingStrategy="BlockLineHeight" Foreground="#FFFFFF" TextOptions.TextFormattingMode="Display" Text="{Binding SelectedServer.Name}" />
              <TextBlock Margin="0,14,0,0" MaxWidth="570" HorizontalAlignment="Left" FontSize="14" LineHeight="23" Foreground="#BABABA" TextWrapping="Wrap" Text="{Binding SelectedServer.Description}" />
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <StackPanel>
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#949494" Text="{helpers:Loc Server_Mode}" />
                  <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#D6D6D6" Text="{Binding SelectedServer.Mode}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding SelectedServer.HasWipe, Converter={StaticResource BoolToVisibility}}">
                  <Border Width="1" Height="24" Margin="18,0" VerticalAlignment="Center" Background="#262626" />
                  <StackPanel>
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#949494" Text="{helpers:Loc Server_Wipe}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="#D6D6D6" Text="{Binding SelectedServer.Wipe}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Height="1" Background="#1F1F1F" />
            <Grid Row="1" Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="4" Height="4" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{StaticResource BrushAccent}" />
                <TextBlock Text="LIVE" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#AAAAAA" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding SelectedServer.HasWipe, Converter={StaticResource BoolToVisibility}}">
                  <Border Width="1" Height="24" Margin="16,0" VerticalAlignment="Center" Background="#242424" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#929292" Text="{helpers:Loc Server_UntilWipe}" />
                    <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="#E4E4E4" Text="{Binding SelectedServer.WipeCountdown}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Border Name="DownloadActionSurface" Grid.Column="1" Width="236" Height="64" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="4">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource BrushWhiteButton}" />
                    <Setter Property="BorderBrush" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsInstalling}">
                        <Setter Property="Background" Value="#141417" />
                        <Setter Property="BorderBrush" Value="#34343C" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                <Grid>
                  <Button Height="62" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.Name="{Binding PlayButtonText}" Command="{Binding PlayCommand}" Visibility="{Binding IsNotInstalling, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                      <Grid Width="20" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlay}" Width="12" Height="14" Fill="#0B0B0B" Stretch="Uniform" Visibility="{Binding IsInstallNeeded, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Path Data="{StaticResource IconDownloadFile}" Width="18" Height="20" Stroke="#0B0B0B" StrokeThickness="2" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="{Binding IsInstallNeeded, Converter={StaticResource BoolToVisibility}}" />
                      </Grid>
                      <TextBlock FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding PlayButtonText}" />
                    </StackPanel>
                  </Button>
                  <Grid Margin="11,7,11,6" ToolTip="{Binding LoadingDetail}" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="18" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="3" />
                    </Grid.RowDefinitions>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontFamily="{StaticResource FontMono}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Text="{Binding LoadingProgress, StringFormat='{}{0:0}%'}" />
                      <TextBlock Grid.Column="1" Margin="7,0,6,0" TextTrimming="CharacterEllipsis" FontSize="8.5" Foreground="#9F9FA8" VerticalAlignment="Center" Text="{Binding LoadingTitle}" />
                      <TextBlock Grid.Column="2" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="{StaticResource BrushAccentLight}" VerticalAlignment="Center" Text="{Binding DownloadSpeedText}" />
                    </Grid>
                    <Grid Row="1" Margin="0,0,0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Margin="0,0,6,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="8.5" Foreground="#A0A0AA" Text="{Binding DownloadSizeText}" />
                      <Button Grid.Column="1" Style="{StaticResource DownloadActionControlStyle}" Margin="0,0,4,0" Command="{Binding TogglePauseCommand}" ToolTip="{Binding PauseButtonTooltip}" AutomationProperties.Name="{Binding PauseButtonText}">
                        <Path Width="10" Height="10" Fill="#EEEEF3" Stretch="Uniform">
                          <FrameworkElement.Style>
                            <Style TargetType="{x:Type Path}">
                              <Setter Property="Data" Value="{StaticResource IconPause}" />
                              <Style.Triggers>
                                <DataTrigger Value="True" Binding="{Binding IsPaused}">
                                  <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </FrameworkElement.Style>
                        </Path>
                      </Button>
                      <Button Grid.Column="2" Style="{StaticResource DownloadActionControlStyle}" Command="{Binding CancelDownloadCommand}" ToolTip="{helpers:Loc Btn_CancelTooltip}" AutomationProperties.Name="{helpers:Loc Btn_CancelTooltip}">
                        <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stroke="#FF6572" StrokeThickness="1.6" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Button>
                    </Grid>
                    <ProgressBar Grid.Row="2" Style="{StaticResource HeaderProgressBarStyle}" Height="3" Background="#303037" Maximum="100" Value="{Binding LoadingProgress, Mode=OneWay}" AutomationProperties.Name="{Binding LoadingTitle}" />
                  </Grid>
                  <ProgressBar Height="2" VerticalAlignment="Bottom" Margin="3,0,3,2" IsHitTestVisible="False" Maximum="100" Value="{Binding LoadingProgress, Mode=OneWay}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource HeaderProgressBarStyle}" TargetType="{x:Type ProgressBar}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Value="True" Binding="{Binding IsLoading}" />
                              <Condition Value="False" Binding="{Binding IsInstalling}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </ProgressBar>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Grid Row="2" Margin="2,0,14,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="18" Height="2" Margin="0,0,10,0" VerticalAlignment="Center" Background="#303030" />
        <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="#CCCCCC" Text="{helpers:Loc Server_SectionTitle}" />
        <Border Margin="10,0,0,0" Padding="6,2" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="3">
          <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#A6A6A6" Text="{Binding Servers.Count, StringFormat='{}{0:00}'}" />
        </Border>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#808080" Text="{helpers:Loc Server_SelectPrompt}" />
    </Grid>
    <ListBox Name="ServerPanel" Grid.Row="4" Margin="0,0,-12,0" ItemContainerStyle="{StaticResource ServerCardItemStyle}" Background="#00FFFFFF" BorderThickness="0" Padding="0" Focusable="False" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" IsEnabled="{Binding CanChangeServer}">
      <UIElement.RenderTransform>
        <TranslateTransform Y="10" />
      </UIElement.RenderTransform>
      <Control.Template>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <ItemsPresenter />
        </ControlTemplate>
      </Control.Template>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="26" Height="20" VerticalAlignment="Center" Background="#191919" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="3">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#C0C0C0" Text="{Binding Code}" />
              </Border>
              <Border Grid.Column="1" Width="1" Height="16" Margin="12,0" VerticalAlignment="Center" Background="#292929" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontDisplay}" FontSize="20.5" FontWeight="SemiBold" Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <Border Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center" Background="#241114" BorderBrush="#5A282E" BorderThickness="1" CornerRadius="3">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource BrushAccentLight}" Text="{helpers:Loc Server_Active}" />
                </Border>
              </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,6,0,0" Orientation="Horizontal">
              <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#B0B0B0" Text="{Binding Mode}" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding HasWipe, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="·" Margin="7,0" FontSize="10" Foreground="#737373" />
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#B0B0B0" Text="{Binding Wipe}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
              <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,7,0" Padding="7,3" Background="#1B1B1B" BorderBrush="#343434" BorderThickness="1" CornerRadius="3">
                      <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#BEBEBE" Text="{Binding}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Padding="7,3" Background="#180F10" BorderBrush="#4A2B2F" BorderThickness="1" CornerRadius="3" Visibility="{Binding HasWipe, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10" Foreground="#C88A90" Text="{Binding WipeCountdownLabel}" />
              </Border>
            </StackPanel>
            <Grid Row="3" Margin="0,4,0,10">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource FontDisplay}" FontSize="38" FontWeight="SemiBold" Text="{Binding OnlineLabel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Margin="9,0,0,8" VerticalAlignment="Bottom" FontSize="10" FontWeight="SemiBold" Foreground="#949494" Text="{helpers:Loc Server_Players}" />
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Bottom" FontFamily="{StaticResource FontMono}" FontSize="13" Foreground="#CCCCCC" Text="{Binding CapacityValueLabel}" />
                <TextBlock Margin="7,0,0,3" VerticalAlignment="Bottom" FontSize="9.5" FontWeight="SemiBold" Foreground="#8E8E8E" Text="{helpers:Loc Server_Slots}" />
              </StackPanel>
            </Grid>
            <Grid Row="4">
              <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#929292" Text="{helpers:Loc Server_Online}" />
              <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="10" Text="{Binding FillPercentLabel}">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="#A2A2A2" />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                        <Setter Property="Foreground" Value="{StaticResource BrushAccentLight}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </TextBlock>
            </Grid>
            <controls:SegmentedProgressBar Grid.Row="5" Height="3" Margin="0,7,0,0" Background="#1E1E1E" SegmentCount="60" SegmentGap="2" SegmentCornerRadius="1" Maximum="{Binding Capacity}" Value="{Binding Online, Mode=OneWay}">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type controls:SegmentedProgressBar}">
                  <Setter Property="Foreground" Value="#4E4E4E" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                      <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </controls:SegmentedProgressBar>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <Grid Name="Footer" Row="6">
      <TextBlock Text="RUST / PC" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#818181" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Background="#251416" BorderBrush="#551D22" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock Text="BETA" FontSize="8.5" FontWeight="Bold" FontFamily="{StaticResource FontMono}" Foreground="{StaticResource BrushAccent}" />
        </Border>
        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontBody}" FontSize="10" Foreground="#969696">
          <Run Text="{helpers:Loc Main_HelpPrefix}" /> <Hyperlink NavigateUri="https://discord.gg/ghEwZrXp4Q" Foreground="#DE4C57" TextDecorations="None" Cursor="Hand" RequestNavigate="SupportLink_OnRequestNavigate"><Run FontWeight="SemiBold" TextDecorations="Underline" Text="{helpers:Loc Main_HelpLink}" /></Hyperlink> <Run Text="{helpers:Loc Main_HelpSuffix}" /></TextBlock>
      </StackPanel>
      <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#818181" Text="{Binding Settings.VersionLabel}" />
    </Grid>
  </Grid>
</UserControl>