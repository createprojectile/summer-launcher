<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Summer.Views.SplashView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Summer.Controls" xmlns:helpers="clr-namespace:Summer.Helpers" Background="#00FFFFFF" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushTextPrimary}" xmlns:views="clr-namespace:Summer.Views;assembly=Summer">
  <Grid Background="{StaticResource BrushBackground}" ClipToBounds="True">
    <Grid Margin="34,22,34,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Row="0">
        <TextBlock Text="SUMMER" FontFamily="{StaticResource FontBody}" FontSize="10.5" FontWeight="SemiBold" Foreground="#9C9C9C" />
        <TextBlock Text="RUST / PC" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#767676" Margin="0,0,28,0" />
      </Grid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <controls:SummerLogo TextSize="46" ShowTagline="True" HorizontalAlignment="Center" />
        <TextBlock Text="SUMMER NETWORK" Margin="0,20,0,0" HorizontalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#7E7E7E" />
      </StackPanel>
      <StackPanel Grid.Row="2" Width="356" HorizontalAlignment="Center">
        <Grid Margin="0,0,0,8">
          <TextBlock FontFamily="{StaticResource FontBody}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Text="{Binding Stage}" />
          <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="{StaticResource BrushTextPrimary}" Text="{Binding PercentLabel}" />
        </Grid>
        <controls:SegmentedProgressBar Style="{StaticResource SplashProgressBarStyle}" Maximum="100" Value="{Binding Progress, Mode=OneWay}" AutomationProperties.Name="{helpers:Loc Splash_CheckUpdates}" />
        <Grid Margin="0,9,0,0">
          <TextBlock FontFamily="{StaticResource FontBody}" FontSize="11.5" Foreground="#878787" Margin="0,0,95,0" TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
          <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="8.5" Foreground="#6E6E6E" Text="{Binding VersionLabel}" />
        </Grid>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Ellipse Width="3" Height="3" Margin="0,0,6,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Setter Property="Fill" Value="#3F3F3F" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsUpdateStageActive}">
                      <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock FontSize="9.5" Foreground="#808080" Text="{helpers:Loc Splash_Updates}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
            <Ellipse Width="3" Height="3" Margin="0,0,6,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Setter Property="Fill" Value="#3F3F3F" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsFilesStageActive}">
                      <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock FontSize="9.5" Foreground="#808080" Text="{helpers:Loc Splash_Files}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0">
            <Ellipse Width="3" Height="3" Margin="0,0,6,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Setter Property="Fill" Value="#3F3F3F" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsLaunchStageActive}">
                      <Setter Property="Fill" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock FontSize="9.5" Foreground="#808080" Text="{helpers:Loc Splash_Launch}" />
          </StackPanel>
        </Grid>
        <Border Margin="0,16,0,0" Padding="10,8" Background="#171011" BorderBrush="#4A2529" BorderThickness="1" CornerRadius="4" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock FontSize="11.5" Foreground="#FF8992" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>