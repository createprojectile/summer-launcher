              <Border Height="1" Background="#222222" Margin="0,16,0,16" />
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Quality]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_Ultra5}" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_DrawDistance]}" />
                <TextBlock Text="2500" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Shadows]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_UltraTssao}" />
              </Grid>
              <Grid Margin="0,0,0,0">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_AA]}" />
                <TextBlock Text="TSSAA" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" />
