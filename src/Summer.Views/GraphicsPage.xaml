            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="03" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="6,2" Background="#1E1C2B" BorderBrush="#3D375B" BorderThickness="1" CornerRadius="3">
                  <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#B0A6DC" Text="{helpers:Loc Graphics_Badge_MaxQuality}" />
                </Border>
              </StackPanel>
              <Border HorizontalAlignment="Right" Padding="7,2" Background="#2A1618" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="3" Visibility="{Binding IsUltraPresetSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Active]}" />
