<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Summer.Views.GraphicsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Summer.Controls" xmlns:helpers="clr-namespace:Summer.Helpers" xmlns:services="clr-namespace:Summer.Services" Background="#00FFFFFF" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushTextPrimary}" xmlns:views="clr-namespace:Summer.Views;assembly=Summer">
  <Grid Margin="32,24,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Title]}" />
        <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="#8C8C8C" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Subtitle]}" />
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButtonStyle}" Height="30" Command="{Binding BackToHomeCommand}">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconArrowLeft}" Width="11" Height="11" Stroke="#AAAAAA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock FontSize="10.5" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Nav_Home]}" />
        </StackPanel>
      </Button>
    </Grid>
    <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorder}" Margin="0,20,0,0" />
    <Grid Row="2" Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <controls:GlowCard Grid.Column="0" CommandParameter="combat" Command="{Binding SelectGraphicsPresetCommand}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource PresetGlowCardStyle}" TargetType="{x:Type controls:GlowCard}">
            <Setter Property="UIElement.Opacity" Value="0.4" />
            <Setter Property="BorderBrush" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  <Condition Value="False" Binding="{Binding IsCombatPresetSelected}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="UIElement.Opacity" Value="0.85" />
                <Setter Property="BorderBrush" Value="#383838" />
              </MultiDataTrigger>
              <DataTrigger Value="True" Binding="{Binding IsCombatPresetSelected}">
                <Setter Property="UIElement.Opacity" Value="1.0" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="1.5" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  <Condition Value="True" Binding="{Binding IsCombatPresetSelected}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid>
          <Image Source="pack://application:,,,/Assets/Graphics/combat.jpg" Stretch="UniformToFill" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#440A0A0A" />
                <GradientStop Offset="0.30" Color="#660A0A0A" />
                <GradientStop Offset="0.58" Color="#D00A0A0A" />
                <GradientStop Offset="0.80" Color="#F40A0A0A" />
                <GradientStop Offset="1" Color="#FF0A0A0A" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Background="#14E05A47" Visibility="{Binding IsCombatPresetSelected, Converter={StaticResource BoolToVisibility}}" />
          <Grid Margin="22">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="01" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="6,2" Background="#1F1A1B" BorderBrush="#3D292B" BorderThickness="1" CornerRadius="3">
                  <TextBlock Text="PVP / FPS" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#D5A0A4" />
                </Border>
              </StackPanel>
              <Border HorizontalAlignment="Right" Padding="7,2" Background="#2A1618" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="3" Visibility="{Binding IsCombatPresetSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Active]}" />
              </Border>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Combat_Title]}" />
              <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="#9E9E9E" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Combat_Subtitle]}" />
              <TextBlock Margin="0,12,0,0" FontSize="11" LineHeight="16" Foreground="#888888" TextWrapping="Wrap" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Combat_Desc]}" />
              <Border Height="1" Background="#222222" Margin="0,16,0,16" />
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Quality]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_Low0}" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_DrawDistance]}" />
                <TextBlock Text="1000" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Shadows]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_Off}" />
              </Grid>
              <Grid Margin="0,0,0,0">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_AA]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_OffFxaa}" />
              </Grid>
            </StackPanel>
            <Border Grid.Row="2" Height="38" Margin="0,20,0,0" CornerRadius="4" BorderThickness="1">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsCombatPresetSelected}">
                      <Setter Property="Background" Value="#1AE05A47" />
                      <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Apply]}" Visibility="{Binding IsCombatPresetSelected, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsCombatPresetSelected, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="✓ " FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" />
                  <TextBlock FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Active]}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </controls:GlowCard>
      <controls:GlowCard Grid.Column="2" CommandParameter="optimal" Command="{Binding SelectGraphicsPresetCommand}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource PresetGlowCardStyle}" TargetType="{x:Type controls:GlowCard}">
            <Setter Property="UIElement.Opacity" Value="0.4" />
            <Setter Property="BorderBrush" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  <Condition Value="False" Binding="{Binding IsOptimalPresetSelected}" />
