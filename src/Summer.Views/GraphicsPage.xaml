                <GradientStop Offset="0.30" Color="#660A0A0A" />
                <GradientStop Offset="0.58" Color="#D00A0A0A" />
                <GradientStop Offset="0.80" Color="#F40A0A0A" />
                <GradientStop Offset="1" Color="#FF0A0A0A" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Background="#14E05A47" Visibility="{Binding IsOptimalPresetSelected, Converter={StaticResource BoolToVisibility}}" />
          <Grid Margin="22">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="02" FontFamily="{StaticResource FontMono}" FontSize="11.5" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                <Border Margin="10,0,0,0" Padding="6,2" Background="#16221A" BorderBrush="#254731" BorderThickness="1" CornerRadius="3">
                  <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#86C498" Text="{helpers:Loc Graphics_Badge_Recommended}" />
                </Border>
              </StackPanel>
              <Border HorizontalAlignment="Right" Padding="7,2" Background="#2A1618" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="3" Visibility="{Binding IsOptimalPresetSelected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Active]}" />
              </Border>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
              <TextBlock FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Optimal_Title]}" />
              <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="#9E9E9E" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Optimal_Subtitle]}" />
              <TextBlock Margin="0,12,0,0" FontSize="11" LineHeight="16" Foreground="#888888" TextWrapping="Wrap" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Optimal_Desc]}" />
              <Border Height="1" Background="#222222" Margin="0,16,0,16" />
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Quality]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_Medium3}" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_DrawDistance]}" />
                <TextBlock Text="1500" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" />
              </Grid>
              <Grid Margin="0,0,0,9">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Shadows]}" />
                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" Text="{helpers:Loc Graphics_Val_Medium}" />
              </Grid>
              <Grid Margin="0,0,0,0">
                <TextBlock FontSize="11" Foreground="#888888" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_AA]}" />
                <TextBlock Text="SMAA" HorizontalAlignment="Right" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="#C8C8C8" />
              </Grid>
            </StackPanel>
            <Border Grid.Row="2" Height="38" Margin="0,20,0,0" CornerRadius="4" BorderThickness="1">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Border}">
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                  <Style.Triggers>
                    <DataTrigger Value="True" Binding="{Binding IsOptimalPresetSelected}">
                      <Setter Property="Background" Value="#1AE05A47" />
                      <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
              <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Apply]}" Visibility="{Binding IsOptimalPresetSelected, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOptimalPresetSelected, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="✓ " FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" />
                  <TextBlock FontFamily="{StaticResource FontBody}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Graphics_Active]}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </controls:GlowCard>
      <controls:GlowCard Grid.Column="4" CommandParameter="ultra" Command="{Binding SelectGraphicsPresetCommand}">
        <FrameworkElement.Style>
          <Style BasedOn="{StaticResource PresetGlowCardStyle}" TargetType="{x:Type controls:GlowCard}">
            <Setter Property="UIElement.Opacity" Value="0.4" />
            <Setter Property="BorderBrush" Value="#222222" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  <Condition Value="False" Binding="{Binding IsUltraPresetSelected}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="UIElement.Opacity" Value="0.85" />
                <Setter Property="BorderBrush" Value="#383838" />
              </MultiDataTrigger>
              <DataTrigger Value="True" Binding="{Binding IsUltraPresetSelected}">
                <Setter Property="UIElement.Opacity" Value="1.0" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="1.5" />
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Value="True" Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" />
                  <Condition Value="True" Binding="{Binding IsUltraPresetSelected}" />
                </MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{StaticResource BrushAccentHover}" />
              </MultiDataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid>
          <Image Source="pack://application:,,,/Assets/Graphics/ultra.jpg" Stretch="UniformToFill" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
          <Border>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#440A0A0A" />
                <GradientStop Offset="0.30" Color="#660A0A0A" />
                <GradientStop Offset="0.58" Color="#D00A0A0A" />
                <GradientStop Offset="0.80" Color="#F40A0A0A" />
                <GradientStop Offset="1" Color="#FF0A0A0A" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Background="#14E05A47" Visibility="{Binding IsUltraPresetSelected, Converter={StaticResource BoolToVisibility}}" />
