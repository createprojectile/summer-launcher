<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Summer.Views.ToolsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Summer.Controls" xmlns:helpers="clr-namespace:Summer.Helpers" Background="#00FFFFFF" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushTextPrimary}" xmlns:views="clr-namespace:Summer.Views;assembly=Summer">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="{helpers:Loc Tools_Title}" />
        <TextBlock Margin="0,5,0,0" FontSize="11.5" Foreground="#8C8C8C" Text="{helpers:Loc Tools_Subtitle}" />
      </StackPanel>
      <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButtonStyle}" Height="30" Command="{Binding BackToHomeCommand}">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconArrowLeft}" Width="11" Height="11" Stroke="#AAAAAA" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
          <TextBlock FontSize="10.5" Text="{helpers:Loc Tools_BackToHome}" />
        </StackPanel>
      </Button>
    </Grid>
    <Border Grid.Row="1" Height="1" Background="{StaticResource BrushBorder}" Margin="0,22,0,0" />
    <ItemsControl Grid.Row="2" Margin="0,24,-12,0" VerticalAlignment="Top" ItemsSource="{Binding Tools}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <controls:GlowCard Style="{StaticResource ToolTileStyle}" Margin="0,0,12,12" AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Row="0">
                <Border Width="34" Height="34" HorizontalAlignment="Left" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6">
                  <Path Width="17" Height="17" Stretch="Uniform" Stroke="#C9C9C9" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{Binding Icon}" />
                </Border>
                <Path Data="{StaticResource IconArrowUpRight}" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,1,0" Stretch="Uniform" Stroke="#5A5A5A" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" />
              </Grid>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,6">
                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#EDEDED" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0" FontSize="11" LineHeight="15" Foreground="#8E8E8E" TextWrapping="Wrap" MaxHeight="32" Text="{Binding Description}" />
              </StackPanel>
              <TextBlock Grid.Row="2" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#767676" Text="{Binding Source}" />
            </Grid>
          </controls:GlowCard>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Grid.Row="3" Style="{StaticResource SurfaceCardStyle}" Padding="16,13" Margin="0,10,0,0">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="{StaticResource IconGlobe}" Width="13" Height="13" Stretch="Uniform" Stroke="#9C9C9C" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
          <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="#8C8C8C" Text="{helpers:Loc Tools_Notice}" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#8E8E8E" Text="{helpers:Loc Tools_Count}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>