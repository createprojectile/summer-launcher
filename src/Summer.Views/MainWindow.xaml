<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Summer.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Summer.Views" xmlns:controls="clr-namespace:Summer.Controls" xmlns:helpers="clr-namespace:Summer.Helpers" Title="Summer" Icon="pack://application:,,,/Assets/app.ico" Width="1260" Height="800" WindowStartupLocation="CenterScreen" Opacity="0">
  <FrameworkElement.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" />
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.985" To="1" Duration="0:0:0.38">
            <DoubleAnimation.EasingFunction>
              <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.985" To="1" Duration="0:0:0.38">
            <DoubleAnimation.EasingFunction>
              <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </FrameworkElement.Triggers>
  <Grid Name="WindowRoot" Background="#00FFFFFF">
    <Border Name="Surface" Style="{StaticResource WindowSurfaceStyle}" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </UIElement.RenderTransform>
      <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource BrushSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
          <Grid Margin="0,20,0,18">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <controls:SummerLogo Grid.Row="0" TextSize="11" HorizontalAlignment="Center" />
            <StackPanel Grid.Row="1" Margin="0,34,0,0" HorizontalAlignment="Center">
              <RadioButton Style="{StaticResource NavRailButtonStyle}" GroupName="MainNavigation" Tag="{StaticResource IconHome}" CommandParameter="Home" Margin="0,0,0,8" AutomationProperties.Name="{helpers:Loc Nav_Home}" IsChecked="{Binding IsHomeActive, Mode=OneWay}" Command="{Binding NavigateCommand}" ToolTip="{helpers:Loc Nav_Home}" />
              <RadioButton Style="{StaticResource NavRailButtonStyle}" GroupName="MainNavigation" Tag="{StaticResource IconMonitor}" CommandParameter="Graphics" Margin="0,0,0,8" AutomationProperties.Name="{helpers:Loc Nav_Graphics}" IsChecked="{Binding IsGraphicsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" ToolTip="{helpers:Loc Nav_Graphics}" />
              <RadioButton Style="{StaticResource NavRailButtonStyle}" GroupName="MainNavigation" Tag="{StaticResource IconWrench}" CommandParameter="Tools" Margin="0,0,0,8" AutomationProperties.Name="{helpers:Loc Nav_Tools}" IsChecked="{Binding IsToolsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" ToolTip="{helpers:Loc Nav_Tools}" />
              <RadioButton Style="{StaticResource NavRailButtonStyle}" GroupName="MainNavigation" Tag="{StaticResource IconSliders}" CommandParameter="Settings" AutomationProperties.Name="{helpers:Loc Nav_Settings}" IsChecked="{Binding IsSettingsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" ToolTip="{helpers:Loc Nav_Settings}" />
            </StackPanel>
          </Grid>
        </Border>
        <Grid Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Background="#0C0C0C">
            <Grid Margin="22,0,8,0" helpers:WindowChrome.IsDragArea="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource StatusDotStyle}" />
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="#A6A6A6" Text="{helpers:Loc Header_PlayingNow}" />
                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource FontBody}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5F5F5" Text="{Binding OnlinePlayersText}" />
              </StackPanel>
              <Grid Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsNotLoading, Converter={StaticResource BoolToVisibility}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type StackPanel}">
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding IsInstallNeeded}">
                          <TriggerBase.EnterActions>
                            <BeginStoryboard Name="PulseInstallStatus">
                              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.9" />
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.EnterActions>
                          <TriggerBase.ExitActions>
                            <StopStoryboard BeginStoryboardName="PulseInstallStatus" />
                          </TriggerBase.ExitActions>
                        </DataTrigger>
                        <DataTrigger Value="True" Binding="{Binding IsUpdateStatus}">
                          <TriggerBase.EnterActions>
                            <BeginStoryboard Name="PulseUpdateStatus">
                              <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:1.1">
                                  <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.EnterActions>
                          <TriggerBase.ExitActions>
                            <StopStoryboard BeginStoryboardName="PulseUpdateStatus" />
                          </TriggerBase.ExitActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Ellipse}">
                        <Setter Property="Fill" Value="#7C7C7C" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUpdateStatus}">
                            <Setter Property="Fill" Value="#F2C55C" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsInstallNeeded}">
                            <Setter Property="Fill" Value="#FF3B47" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsReadyToLaunch}">
                            <Setter Property="Fill" Value="#2ECC71" />
                            <TriggerBase.EnterActions>
                              <BeginStoryboard Name="PulseDot">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:1.1" />
                                </Storyboard>
                              </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                              <StopStoryboard BeginStoryboardName="PulseDot" />
                            </TriggerBase.ExitActions>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </Ellipse>
                  <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource FontBody}" FontSize="11.5" FontWeight="SemiBold" Text="{Binding IdleStatusText}">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="#A0A0A0" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsUpdateStatus}">
                            <Setter Property="Foreground" Value="#F2C55C" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsInstallNeeded}">
                            <Setter Property="Foreground" Value="#FF4A55" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsReadyToLaunch}">
                            <Setter Property="Foreground" Value="#2ECC71" />
                            <TriggerBase.EnterActions>
                              <BeginStoryboard Name="PulseText">
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.5" Duration="0:0:1.1" />
                                </Storyboard>
                              </BeginStoryboard>
                            </TriggerBase.EnterActions>
                            <TriggerBase.ExitActions>
                              <StopStoryboard BeginStoryboardName="PulseText" />
                            </TriggerBase.ExitActions>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                  <controls:LoadingSpinner Width="12" Height="12" Margin="0,0,8,0" Foreground="{StaticResource BrushAccentLight}" />
                  <TextBlock MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#E1E1E1" Text="{Binding LoadingTitle}" />
                  <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10.5" Foreground="#9A9A9A" Text="{Binding LoadingProgress, StringFormat='{}{0:0}%'}" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentLight}" Text="{Binding DownloadSpeedText}" Visibility="{Binding DownloadSpeedText, Converter={StaticResource StringNotEmptyToVisibility}}" />
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RUST / PC" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9.5" Foreground="#868686" />
                <Border Width="1" Height="18" Background="{StaticResource BrushBorder}" Margin="12,0,10,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource SocialLinkButtonStyle}" Tag="{StaticResource IconDiscord}" CommandParameter="https://discord.gg/ghEwZrXp4Q" AutomationProperties.Name="Discord" ToolTip="Discord" Margin="1,0" Click="SocialLinkButton_OnClick" />
                <Button Style="{StaticResource SocialLinkButtonStyle}" Tag="{StaticResource IconTelegram}" CommandParameter="https://t.me/summer_rust_news" AutomationProperties.Name="Telegram" ToolTip="Telegram" Margin="1,0" Click="SocialLinkButton_OnClick" />
                <Button Style="{StaticResource SocialLinkButtonStyle}" Tag="{StaticResource IconVk}" CommandParameter="https://vk.ru/summer_rust" AutomationProperties.Name="VK" ToolTip="VK" Margin="1,0" Click="SocialLinkButton_OnClick" />
                <Border Width="1" Height="18" Background="{StaticResource BrushBorder}" Margin="10,0,8,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource WindowControlButtonStyle}" Tag="{StaticResource IconMinimize}" Width="28" Height="28" AutomationProperties.Name="{helpers:Loc Header_Minimize}" ToolTip="{helpers:Loc Header_Minimize}" Click="MinimizeButton_OnClick" />
                <Button Style="{StaticResource WindowCloseButtonStyle}" Tag="{StaticResource IconClose}" Width="28" Height="28" AutomationProperties.Name="{helpers:Loc Header_Close}" ToolTip="{helpers:Loc Header_Close}" Click="CloseButton_OnClick" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid Row="1" Background="{StaticResource BrushBackgroundSoft}">
            <Grid Name="HomeHost" Visibility="{Binding IsHomeActive, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="PageHost_OnIsVisibleChanged">
              <UIElement.RenderTransform>
                <TranslateTransform Y="0" />
              </UIElement.RenderTransform>
              <views:MainPage />
            </Grid>
            <Grid Name="GraphicsHost" Visibility="{Binding IsGraphicsActive, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="PageHost_OnIsVisibleChanged">
              <UIElement.RenderTransform>
                <TranslateTransform Y="0" />
              </UIElement.RenderTransform>
              <views:GraphicsPage />
            </Grid>
            <Grid Name="ToolsHost" Visibility="{Binding IsToolsActive, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="PageHost_OnIsVisibleChanged">
              <UIElement.RenderTransform>
                <TranslateTransform Y="0" />
              </UIElement.RenderTransform>
              <views:ToolsPage />
            </Grid>
            <Grid Name="SettingsHost" Visibility="{Binding IsSettingsActive, Converter={StaticResource BoolToVisibility}}" IsVisibleChanged="PageHost_OnIsVisibleChanged">
              <UIElement.RenderTransform>
                <TranslateTransform Y="0" />
              </UIElement.RenderTransform>
              <views:SettingsPage DataContext="{Binding Settings}" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Border Name="ConnectToast" Width="294" Height="76" Margin="0,72,24,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="100" Background="#F0181C19" BorderBrush="#36533E" BorderThickness="1" CornerRadius="8" Padding="14,11" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite">
      <UIElement.RenderTransform>
        <TranslateTransform X="0" />
      </UIElement.RenderTransform>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#193B29" CornerRadius="8" BorderBrush="#4DCE85" BorderThickness="1">
            <Path Data="M18,6 L7,17 L2,12 M22,10 L14.5,17.5 L13,16" Width="19" Height="15" Stroke="#72EDA8" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="connect скопирован" Foreground="#F1F5F2" FontSize="12" FontWeight="SemiBold" />
            <TextBlock Name="ConnectToastAddress" Margin="0,4,0,0" Foreground="#9FAFA4" FontFamily="{StaticResource FontMono}" FontSize="10" />
          </StackPanel>
        </Grid>
        <ProgressBar Name="ConnectToastLifetime" Grid.Row="1" Margin="0,7,0,0" Height="2" Style="{StaticResource HeaderProgressBarStyle}" Foreground="#4DCE85" Background="#29362E" Maximum="100" Value="100" />
      </Grid>
    </Border>
    <Border Width="420" Margin="0,72,24,0" Padding="16" CornerRadius="8" Panel.ZIndex="101" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#F0211D15" BorderBrush="#806433" BorderThickness="1" AutomationProperties.LiveSetting="Assertive" Visibility="{Binding IsLauncherLocationValid, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path Data="{StaticResource IconFolder}" Width="19" Height="19" Stroke="#E5B768" StrokeThickness="1.7" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" StrokeLineJoin="Round" />
        <StackPanel Grid.Column="1">
          <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="#FFE0A7" Text="{helpers:Loc Launcher_LocationTitle}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#D7C5A7" Text="{helpers:Loc Launcher_LocationMessage}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>