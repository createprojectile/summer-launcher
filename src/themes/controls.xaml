  </Style>
  <Style x:Key="TextLinkButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BareButtonStyle}">
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource BrushAccentLight}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="WindowControlButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="3">
            <Path Width="11" Height="11" Data="{TemplateBinding FrameworkElement.Tag}" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="#1F1F1F" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="#2B2B2B" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="WindowCloseButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="3">
            <Path Width="11" Height="11" Data="{TemplateBinding FrameworkElement.Tag}" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="{StaticResource BrushAccent}" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="#B31522" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SocialLinkButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="#868686" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="4">
            <Path Width="15" Height="15" Data="{TemplateBinding FrameworkElement.Tag}" Fill="{TemplateBinding Control.Foreground}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="#1F1F1F" />
              <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Border.Background" Value="#2B2B2B" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavRailButtonStyle" TargetType="{x:Type RadioButton}">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Foreground" Value="#8A8A8A" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border Name="ActiveBar" Width="2" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="1" Opacity="0" RenderTransformOrigin="0.5,0.5" Background="{StaticResource BrushAccent}">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleY="0.2" />
              </UIElement.RenderTransform>
            </Border>
            <Border Name="Surface" Background="{TemplateBinding Control.Background}" CornerRadius="4">
              <Grid>
                <Border Name="Hover" Background="#FFFFFF" CornerRadius="3" Opacity="0" IsHitTestVisible="False" />
                <Path Width="19" Height="19" Data="{TemplateBinding FrameworkElement.Tag}" Stroke="{TemplateBinding Control.Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="#E5E5E5" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.055" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="#FFFFFF" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="ActiveBar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.2" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="KeyCaptureButtonStyle" TargetType="{x:Type controls:KeyCaptureButton}">
    <Setter Property="Width" Value="96" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="Background" Value="#101010" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:KeyCaptureButton}">
          <Border Name="Surface" Background="{TemplateBinding Control.Background}" BorderThickness="1" CornerRadius="4" BorderBrush="{StaticResource BrushBorderStrong}">
            <Grid>
              <TextBlock Name="KeyText" Text="{TemplateBinding controls:KeyCaptureButton.KeyName}" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding Control.Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" />
              <TextBlock Name="CaptureText" Text="Нажмите…" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushAccentLight}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:KeyCaptureButton.KeyName" Value="">
              <Setter TargetName="KeyText" Property="TextBlock.Text" Value="—" />
              <Setter TargetName="KeyText" Property="TextBlock.Foreground" Value="#6A6A6A" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Border.BorderBrush" Value="#6A6A6A" />
              <Setter TargetName="Surface" Property="Border.Background" Value="#181818" />
            </Trigger>
            <Trigger Property="controls:KeyCaptureButton.IsCapturing" Value="True">
              <Setter TargetName="Surface" Property="Border.BorderBrush" Value="{StaticResource BrushAccentLight}" />
              <Setter TargetName="Surface" Property="Border.Background" Value="#201011" />
              <Setter TargetName="KeyText" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="CaptureText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="InputTextBoxStyle" TargetType="{x:Type TextBox}">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{StaticResource BrushInput}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="#FFFFFF" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="#66E11D2E" />
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Grid>
            <Border Name="InputSurface" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True" />
            <TextBlock Name="Placeholder" Text="{TemplateBinding FrameworkElement.Tag}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" FontSize="11" IsHitTestVisible="False" Visibility="Collapsed" FontFamily="{StaticResource FontBody}" Foreground="{StaticResource BrushTextMuted}" />
            <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="InputSurface" Property="Border.Background" Value="{StaticResource BrushInputHover}" />
              <Setter TargetName="InputSurface" Property="Border.BorderBrush" Value="#4A4A4A" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="InputSurface" Property="Border.BorderBrush" Value="#BDBDBD" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SummerToggleSwitchStyle" TargetType="{x:Type ToggleButton}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Track" Background="#242424" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="11">
            <Border Name="Thumb" Width="16" Height="16" Margin="2" HorizontalAlignment="Left" Background="#ADADAD" CornerRadius="8">
              <UIElement.RenderTransform>
                <TranslateTransform X="0" />
              </UIElement.RenderTransform>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Border.BorderBrush" Value="#666666" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Track" Property="Border.Background" Value="{StaticResource BrushAccent}" />
              <Setter TargetName="Track" Property="Border.BorderBrush" Value="{StaticResource BrushAccent}" />
              <Setter TargetName="Thumb" Property="Border.Background" Value="#FFFFFF" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFillButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Background="#00FFFFFF">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{StaticResource BrushAccent}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderEmptyButtonStyle" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumbStyle" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Ellipse Name="Dot" Width="12" Height="12" Fill="#F5F5F5" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="Shape.Fill" Value="#FFFFFF" />
