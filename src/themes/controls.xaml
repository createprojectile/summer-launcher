        <ControlTemplate TargetType="{x:Type controls:GlowCard}">
          <Border Name="Card" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" ClipToBounds="True" SnapsToDevicePixels="True">
