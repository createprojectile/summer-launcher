  <Style x:Key="PillTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
  </Style>
  <Style x:Key="MonoTextStyle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
  </Style>
  <Style x:Key="SurfaceCardStyle" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource BrushPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
