  </Style>
  <Style x:Key="SummerSliderStyle" TargetType="{x:Type Slider}">
    <Setter Property="Height" Value="24" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Border Height="4" VerticalAlignment="Center" Background="#262626" CornerRadius="2" />
            <Track Name="PART_Track" Height="24" VerticalAlignment="Center" Orientation="{TemplateBinding Slider.Orientation}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderFillButtonStyle}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumbStyle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderEmptyButtonStyle}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SplashProgressBarStyle" TargetType="{x:Type controls:SegmentedProgressBar}">
    <Setter Property="Height" Value="5" />
    <Setter Property="Background" Value="#262626" />
    <Setter Property="Foreground" Value="{StaticResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="controls:SegmentedProgressBar.SegmentCount" Value="40" />
    <Setter Property="controls:SegmentedProgressBar.SegmentGap" Value="2" />
    <Setter Property="controls:SegmentedProgressBar.SegmentCornerRadius" Value="1" />
